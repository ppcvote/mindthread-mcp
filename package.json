{
  "name": "mindthread-mcp",
  "version": "0.2.0",
  "description": "Threads scheduler for AI agents: MindThread's MCP server over stdio (write, schedule and publish Threads posts, review replies, read insights).",
  "mcpName": "io.github.ppcvote/mindthread",
  "type": "module",
  "bin": {
    "mindthread-mcp": "dist/index.js"
  },
  "files": [
    "dist/*.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/bridge.test.mjs test/server-json.test.mjs",
    "test:live": "npm run build && node --test test/live.test.mjs",
    "tools-table": "node scripts/tools-table.mjs",
    "prepublishOnly": "npm test && npm run test:live"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "threads",
    "threads-api",
    "meta-threads",
    "social-media",
    "scheduler",
    "ai-agent",
    "claude",
    "cursor",
    "mindthread"
  ],
  "author": "Ultra Lab <contact@ultralab.tw> (https://ultralab.tw)",
  "license": "MIT",
  "homepage": "https://github.com/ppcvote/mindthread-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ppcvote/mindthread-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ppcvote/mindthread-mcp/issues"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  }
}
